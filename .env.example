# Supabase 配置
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Edge Function 网关地址（Supabase 项目下的函数 URL）
VITE_API_BASE=https://your-project-ref.supabase.co/functions/v1/api-gateway

# 百度地图 API Key
VITE_BAIDU_MAP_AK=your-baidu-map-ak

# JWT Secret（仅用于后端 Edge Function，前端不需要）
JWT_SECRET=your-jwt-secret-min-32-chars